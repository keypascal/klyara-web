{
  // Klyara — static site served by a Cloudflare Worker.
  //
  // The assets directory is the repo root: one tree, matching the OneDrive
  // folder. That means EVERYTHING here is publicly served unless .assetsignore
  // excludes it. Read .assetsignore before adding anything to this repo.
  "name": "klyara-web",
  "compatibility_date": "2026-08-26",

  "assets": {
    "directory": ".",

    // /about -> /about.html, and /about/ redirects to /about
    "html_handling": "auto-trailing-slash",

    // unmatched paths render 404.html with a 404 status
    "not_found_handling": "404-page"
  },

  // Custom Domains: the Worker IS the origin. Cloudflare creates the DNS
  // records and issues the certificates on deploy — do not hand-edit these
  // rows in the dashboard.
  //
  // A Custom Domain cannot be created on a hostname that already has a DNS
  // record. If either of these ever fails to attach, check DNS > Records for a
  // leftover row on that hostname and delete it before redeploying.
  "routes": [
    { "pattern": "klyara.com", "custom_domain": true },
    { "pattern": "www.klyara.com", "custom_domain": true }
  ]
}
